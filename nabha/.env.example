# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster> with your Atlas cluster credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nabha?retryWrites=true&w=majority

# Database Name (default: nabha)
DB_NAME=nabha

# Application Port
PORT=5000

# Auth Token Secret
SECRET=nabha-secret

# Demo mode (true shows demo info, false hides)
DEMO_MODE=true
